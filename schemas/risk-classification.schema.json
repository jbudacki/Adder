{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adder.example/schemas/risk-classification.schema.json",
  "title": "ADDER Risk Classification",
  "description": "An evidence-backed ADDER change-risk classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit",
    "risk_tier",
    "rationales",
    "required_treatment",
    "needs_confirmation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "repository": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "merge_request": { "type": "string" },
    "risk_tier": { "enum": [1, 2, 3] },
    "rationales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "evidence"],
        "properties": {
          "signal": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "location": { "type": "string" }
        }
      }
    },
    "required_treatment": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "affected_trust_boundaries": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "needs_confirmation": { "type": "boolean" }
  }
}

