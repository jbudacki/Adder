{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adder.example/schemas/recovery-plan.schema.json",
  "title": "ADDER Recovery Record",
  "description": "A controlled remediation and independent-verification record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recovery_id",
    "subject",
    "trigger_findings",
    "owner",
    "status",
    "containment_actions",
    "corrective_actions",
    "verification_steps",
    "required_approvals",
    "residual_risk",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "recovery_id": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "affected_revision"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "affected_revision": { "type": "string", "minLength": 1 },
        "corrected_revision": { "type": "string" },
        "merge_request": { "type": "string" },
        "affected_environments": { "type": "array", "items": { "type": "string" } },
        "affected_artifacts": { "type": "array", "items": { "type": "string" } },
        "known_good_reference": { "type": "string" }
      }
    },
    "trigger_findings": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "planned",
        "containment_pending",
        "remediation_in_progress",
        "verification_pending",
        "ready_for_human_approval",
        "verified",
        "failed"
      ]
    },
    "containment_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "corrective_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verification" }
    },
    "verification_evidence": { "type": "array", "items": { "type": "string" } },
    "rebuilt_artifacts": { "type": "array", "items": { "type": "string" } },
    "required_approvals": { "type": "array", "items": { "type": "string" } },
    "approval_evidence": { "type": "array", "items": { "type": "string" } },
    "rollback_reference": { "type": "string" },
    "residual_risk": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "verified" } },
        "required": ["status"]
      },
      "then": {
        "required": ["verification_evidence"],
        "properties": {
          "verification_evidence": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "verified" },
          "required_approvals": { "minItems": 1 }
        },
        "required": ["status", "required_approvals"]
      },
      "then": {
        "required": ["approval_evidence"],
        "properties": {
          "approval_evidence": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "status", "owner", "authorization_required"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "authorized", "completed", "failed", "not_applicable"] },
        "owner": { "type": "string", "minLength": 1 },
        "authorization_required": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "required", "status"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": { "enum": ["not_run", "passed", "failed", "not_applicable"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "performed_by": { "type": "string" }
      }
    }
  }
}
