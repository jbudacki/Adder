{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adder.example/schemas/pilot-observation.schema.json",
  "title": "ADDER Pilot Observation",
  "description": "One measured ADDER pilot assessment with validation outcomes and effort data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "repository_type",
    "assessment_id",
    "provenance_verifiable",
    "seeded_or_validated_scenarios",
    "confirmed_scenarios_detected",
    "findings_reviewed",
    "false_positives",
    "review_minutes",
    "human_review_minutes",
    "risky_changes",
    "risky_changes_block_recommended",
    "reusable_controls_created",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "observation_id": { "type": "string", "minLength": 1 },
    "repository_type": { "enum": ["enterprise_application", "infrastructure", "ai_agent"] },
    "repository_reference": { "type": "string" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "provenance_verifiable": { "type": "boolean" },
    "seeded_or_validated_scenarios": { "type": ["integer", "null"], "minimum": 0 },
    "confirmed_scenarios_detected": { "type": ["integer", "null"], "minimum": 0 },
    "findings_reviewed": { "type": ["integer", "null"], "minimum": 0 },
    "false_positives": { "type": ["integer", "null"], "minimum": 0 },
    "review_minutes": { "type": ["number", "null"], "minimum": 0 },
    "human_review_minutes": { "type": ["number", "null"], "minimum": 0 },
    "risky_changes": { "type": ["integer", "null"], "minimum": 0 },
    "risky_changes_block_recommended": { "type": ["integer", "null"], "minimum": 0 },
    "remediation_minutes": { "type": ["number", "null"], "minimum": 0 },
    "recovery_minutes": { "type": ["number", "null"], "minimum": 0 },
    "reusable_controls_created": { "type": "integer", "minimum": 0 },
    "notes": { "type": "array", "items": { "type": "string" } },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
