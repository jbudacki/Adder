{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adder.example/schemas/test-evidence-assessment.schema.json",
  "title": "ADDER Security Test Evidence Assessment",
  "description": "Behavior-to-test evidence and sufficiency assessment for a security-sensitive change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "subject",
    "risk_tier",
    "behavior_claims",
    "execution_status",
    "independence_status",
    "status",
    "checks_not_performed",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "merge_request": { "type": "string" }
      }
    },
    "risk_tier": { "enum": [1, 2, 3] },
    "behavior_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_id", "claim", "control_location", "coverage", "assertion_strength", "status"],
        "properties": {
          "behavior_id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "control_location": { "type": "string", "minLength": 1 },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "test_location", "result"],
              "properties": {
                "kind": { "enum": ["positive", "negative", "boundary", "failure", "state_transition", "concurrency", "regression"] },
                "test_location": { "type": "string", "minLength": 1 },
                "result": { "enum": ["pass", "fail", "not_run", "unavailable"] },
                "observed_outcome": { "type": "string" }
              }
            }
          },
          "assertion_strength": { "enum": ["strong", "weak", "none", "unknown"] },
          "baseline_discrimination": { "enum": ["old_fails_new_passes", "not_demonstrated", "not_applicable", "unknown"] },
          "status": { "enum": ["sufficient", "insufficient", "manual_review"] },
          "gaps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "execution_status": { "enum": ["passed", "failed", "not_run", "partial", "unavailable"] },
    "independence_status": { "enum": ["independent", "not_independent", "mixed", "unknown"] },
    "status": { "enum": ["sufficient", "insufficient", "manual_review"] },
    "finding_ids": { "type": "array", "items": { "type": "string" } },
    "required_actions": { "type": "array", "items": { "type": "string" } },
    "checks_not_performed": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
