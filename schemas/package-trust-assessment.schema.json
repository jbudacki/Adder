{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adder.example/schemas/package-trust-assessment.schema.json",
  "title": "ADDER Package Trust Assessment",
  "description": "Attributable package identity, integrity, intelligence, and trust evidence for one exact package coordinate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "package",
    "registry",
    "publisher_status",
    "integrity_status",
    "lockfile_consistency",
    "vulnerability_status",
    "malware_status",
    "reputation_status",
    "evidence_sources",
    "observed_at",
    "status",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "scope", "declared_source"],
      "properties": {
        "ecosystem": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["production", "development", "test", "build", "optional", "unknown"] },
        "declared_source": { "type": "string", "minLength": 1 },
        "resolved_artifact": { "type": "string" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "approved", "package_status", "version_status"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "approved": { "enum": ["yes", "no", "unknown"] },
        "package_status": { "enum": ["exists", "not_found", "unknown", "unavailable"] },
        "version_status": { "enum": ["exists", "not_found", "unknown", "unavailable"] }
      }
    },
    "publisher_status": { "enum": ["verified", "mismatch", "unverified", "unknown", "unavailable"] },
    "integrity_status": { "enum": ["verified", "mismatch", "missing", "unknown", "unavailable"] },
    "lockfile_consistency": { "enum": ["consistent", "inconsistent", "not_applicable", "unknown"] },
    "vulnerability_status": { "enum": ["no_applicable_signal", "affected", "unknown", "unavailable"] },
    "malware_status": { "enum": ["no_signal", "signal", "confirmed", "unknown", "unavailable"] },
    "reputation_status": { "enum": ["acceptable", "concern", "unknown", "unavailable"] },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "check", "result", "observed_at"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "reference": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["verified", "concern", "manual_review", "block_recommended"] },
    "finding_ids": { "type": "array", "items": { "type": "string" } },
    "required_actions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
